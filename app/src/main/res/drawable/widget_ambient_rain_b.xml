<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget ambient frame: rain, phase B of 3.

  RemoteViews cannot host Compose, so AmbientBackground's live canvas cannot be
  reused in a widget. These layer-lists reproduce its visual LANGUAGE with
  static art; NazoWidgetProvider cross-fades A -> B -> C in a ViewFlipper, which
  is a supported RemoteViews view, to suggest motion without a frame loop.
  Drift between phases is deliberately small so the effect reads as ambient
  rather than as a slideshow.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1A2620" />
            <corners android:radius="24dp" />
            <stroke android:width="1dp" android:color="#2E4237" />
        </shape>
    </item>
    <item android:left="124dp" android:top="12dp" android:width="2dp" android:height="14dp">
        <shape android:shape="rectangle">
            <solid android:color="#24694A" />
            <corners android:radius="1dp" />
        </shape>
    </item>
    <item android:left="142dp" android:top="30dp" android:width="2dp" android:height="10dp">
        <shape android:shape="rectangle">
            <solid android:color="#1F5A3D" />
            <corners android:radius="1dp" />
        </shape>
    </item>
    <item android:left="160dp" android:top="20dp" android:width="2dp" android:height="8dp">
        <shape android:shape="rectangle">
            <solid android:color="#1F5A3D" />
            <corners android:radius="1dp" />
        </shape>
    </item>
    <item android:left="176dp" android:top="8dp" android:width="2dp" android:height="12dp">
        <shape android:shape="rectangle">
            <solid android:color="#24694A" />
            <corners android:radius="1dp" />
        </shape>
    </item>
</layer-list>
