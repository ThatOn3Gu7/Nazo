<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget ambient frame: orbs, phase A of 3.

  RemoteViews cannot host Compose, so AmbientBackground's live canvas cannot be
  reused in a widget. These layer-lists reproduce its visual LANGUAGE with
  static art; NazoWidgetProvider cross-fades A -> B -> C in a ViewFlipper, which
  is a supported RemoteViews view, to suggest motion without a frame loop.
  Drift between phases is deliberately small so the effect reads as ambient
  rather than as a slideshow.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1A2620" />
            <corners android:radius="24dp" />
            <stroke android:width="1dp" android:color="#2E4237" />
        </shape>
    </item>
    <item android:left="116dp" android:top="8dp" android:width="30dp" android:height="30dp">
        <shape android:shape="oval">
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#24694A" />
        </shape>
    </item>
    <item android:left="156dp" android:top="26dp" android:width="20dp" android:height="20dp">
        <shape android:shape="oval">
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#1F5A3D" />
        </shape>
    </item>
    <item android:left="180dp" android:top="10dp" android:width="6dp" android:height="6dp">
        <shape android:shape="oval">
            <solid android:color="#1F5A3D" />
        </shape>
    </item>
</layer-list>
