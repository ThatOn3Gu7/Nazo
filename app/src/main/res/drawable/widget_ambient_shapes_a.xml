<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget ambient frame: shapes, phase A of 3.

  RemoteViews cannot host Compose, so AmbientBackground's live canvas cannot be
  reused in a widget. These layer-lists reproduce its visual LANGUAGE with
  static art; NazoWidgetProvider cross-fades A -> B -> C in a ViewFlipper, which
  is a supported RemoteViews view, to suggest motion without a frame loop.
  Drift between phases is deliberately small so the effect reads as ambient
  rather than as a slideshow.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1A2620" />
            <corners android:radius="24dp" />
            <stroke android:width="1dp" android:color="#2E4237" />
        </shape>
    </item>
    <item android:left="118dp" android:top="6dp" android:width="26dp" android:height="26dp">
        <shape android:shape="rectangle">
            <solid android:color="#1F5A3D" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:left="152dp" android:top="34dp" android:width="16dp" android:height="16dp">
        <shape android:shape="rectangle">
            <solid android:color="#24694A" />
            <corners android:radius="5dp" />
        </shape>
    </item>
    <item android:left="96dp" android:top="40dp" android:width="12dp" android:height="12dp">
        <shape android:shape="rectangle">
            <solid android:color="#1F5A3D" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</layer-list>
