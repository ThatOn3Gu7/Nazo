<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget ambient frame: constellation, phase C of 3.

  RemoteViews cannot host Compose, so AmbientBackground's live canvas cannot be
  reused in a widget. These layer-lists reproduce its visual LANGUAGE with
  static art; NazoWidgetProvider cross-fades A -> B -> C in a ViewFlipper, which
  is a supported RemoteViews view, to suggest motion without a frame loop.
  Drift between phases is deliberately small so the effect reads as ambient
  rather than as a slideshow.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1A2620" />
            <corners android:radius="24dp" />
            <stroke android:width="1dp" android:color="#2E4237" />
        </shape>
    </item>
    <item android:left="118dp" android:top="12dp" android:width="4dp" android:height="4dp">
        <shape android:shape="oval">
            <solid android:color="#2E8560" />
        </shape>
    </item>
    <item android:left="150dp" android:top="32dp" android:width="3dp" android:height="3dp">
        <shape android:shape="oval">
            <solid android:color="#24694A" />
        </shape>
    </item>
    <item android:left="166dp" android:top="10dp" android:width="3dp" android:height="3dp">
        <shape android:shape="oval">
            <solid android:color="#24694A" />
        </shape>
    </item>
    <item android:left="122dp" android:top="15dp" android:width="28dp" android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#1F5A3D" />
            <corners android:radius="0dp" />
        </shape>
    </item>
    <item android:left="153dp" android:top="21dp" android:width="16dp" android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#1F5A3D" />
            <corners android:radius="0dp" />
        </shape>
    </item>
</layer-list>
