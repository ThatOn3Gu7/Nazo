<?xml version="1.0" encoding="utf-8"?>
<!-- Makimono (mystery scroll) with a wax seal. Full-color foreground mark;
     flat companion in ic_mark_scroll_silhouette.xml. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- parchment sheet -->
    <path
        android:fillColor="#FFF7ECD2"
        android:pathData="M30,28 L78,28 L78,80 L30,80 Z" />
    <!-- shaded right edge -->
    <path
        android:fillColor="#FFE6D4AE"
        android:pathData="M70,28 L78,28 L78,80 L70,80 Z" />
    <!-- written lines -->
    <path
        android:strokeColor="#FFBCA982"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M38,40 L66,40 M38,49 L66,49 M38,67 L58,67" />
    <!-- top roller -->
    <path
        android:fillColor="#FF8C5A22"
        android:pathData="M24,22 L84,22 A5,5 0 0 1 84,32 L24,32 A5,5 0 0 1 24,22 Z" />
    <!-- bottom roller -->
    <path
        android:fillColor="#FF8C5A22"
        android:pathData="M24,76 L84,76 A5,5 0 0 1 84,86 L24,86 A5,5 0 0 1 24,76 Z" />
    <!-- wax seal -->
    <path
        android:fillColor="#FFC8382B"
        android:pathData="M54,58 m-10,0 a10,10 0 1,0 20,0 a10,10 0 1,0 -20,0" />
    <path
        android:fillColor="#FFA82A20"
        android:pathData="M54,58 m-5,0 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0" />
</vector>
