<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission 
        android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />                
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ComposeEmptyActivity">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Nazo.Splash" />

        <!-- Launcher entries (the real activity is never disabled). Exactly one is
             enabled at a time, chosen by the device's OS dark/light mode. -->
        <activity-alias
            android:name=".LauncherLight"
            android:targetActivity=".MainActivity"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <activity-alias
            android:name=".LauncherDark"
            android:targetActivity=".MainActivity"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher_dark"
            android:roundIcon="@mipmap/ic_launcher_round_dark"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>







        <!-- Sakura: a real <activity> (not an alias) so its manifest theme sets the
             cold-start starting window color before the process exists. -->
        <activity
            android:name=".LauncherSakura"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher_sakura"
            android:roundIcon="@mipmap/ic_launcher_round_sakura"
            android:theme="@style/Theme.Nazo.Splash.Sakura"
            android:launchMode="singleTask"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="quiz.thaton3app.nazo.action.DAILY" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>



        <!-- Midnight: a real <activity> (not an alias) so its manifest theme sets the
             cold-start starting window color before the process exists. -->
        <activity
            android:name=".LauncherMidnight"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher_midnight"
            android:roundIcon="@mipmap/ic_launcher_round_midnight"
            android:theme="@style/Theme.Nazo.Splash.Midnight"
            android:launchMode="singleTask"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="quiz.thaton3app.nazo.action.DAILY" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Ocean: a real <activity> (not an alias) so its manifest theme sets the
             cold-start starting window color before the process exists. -->
        <activity
            android:name=".LauncherOcean"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher_ocean"
            android:roundIcon="@mipmap/ic_launcher_round_ocean"
            android:theme="@style/Theme.Nazo.Splash.Ocean"
            android:launchMode="singleTask"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="quiz.thaton3app.nazo.action.DAILY" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Lantern: illustrated mark. Real <activity> so its manifest theme colors the
             starting window before the process exists. -->
        <activity
            android:name=".LauncherLantern"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher_lantern"
            android:roundIcon="@mipmap/ic_launcher_round_lantern"
            android:theme="@style/Theme.Nazo.Splash.Lantern"
            android:launchMode="singleTask"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="quiz.thaton3app.nazo.action.DAILY" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Torii: illustrated mark. Real <activity> so its manifest theme colors the
             starting window before the process exists. -->
        <activity
            android:name=".LauncherTorii"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher_torii"
            android:roundIcon="@mipmap/ic_launcher_round_torii"
            android:theme="@style/Theme.Nazo.Splash.Torii"
            android:launchMode="singleTask"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="quiz.thaton3app.nazo.action.DAILY" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Scroll: illustrated mark. Real <activity> so its manifest theme colors the
             starting window before the process exists. -->
        <activity
            android:name=".LauncherScroll"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher_scroll"
            android:roundIcon="@mipmap/ic_launcher_round_scroll"
            android:theme="@style/Theme.Nazo.Splash.Scroll"
            android:launchMode="singleTask"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="quiz.thaton3app.nazo.action.DAILY" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Home-screen widget: streak + daily-challenge status. -->
        <receiver
            android:name=".widget.NazoWidgetProvider"
            android:exported="false"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_nazo_info" />
        </receiver>

        <receiver
            android:name=".data.DownloadReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.DOWNLOAD_COMPLETE" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
    
</manifest>